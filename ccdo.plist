<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.corevider.ccdo</string>

  <key>ProgramArguments</key>
  <array>
    <string>@BIN@/ccdo</string>
  </array>

  <!-- Start at login and bring it back if it dies, the way the systemd unit
       does on Linux. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardErrorPath</key>
  <string>/tmp/ccdo.err</string>
</dict>
</plist>
